<mxfile host="app.diagrams.net">
  <diagram id="design-patent-views-flow" name="外观专利六视图生成流程">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="外观专利六视图自动生成 — 实现流程图（本地开源版 · 合规规格已固化）" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- 开始 -->
        <mxCell id="start" value="开始：本地批处理" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="390" y="50" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- 输入 -->
        <mxCell id="input" value="输入准备&#10;STEP/STP + config（产品名称/用途/主视图方位/&#10;整体 or 局部外观 / 省略视图及原因）" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="130" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- ① -->
        <mxCell id="p1" value="① 输入解析与校验&#10;STEP → FreeCAD Part 导入&#10;破面/非流形检查 → 警告不中断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="230" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p1e" value="失败 → 错误报告&#10;跳过该文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="239" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_p1e" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;fontSize=11;" edge="1" parent="1" source="p1" target="p1e">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 人工确认① -->
        <mxCell id="manual1" value="人工确认点 ①&#10;核对主视图方位" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="338" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- ② -->
        <mxCell id="p2" value="② 几何预处理&#10;按主视图方位重定向 → 计算包围盒&#10;推导六视图方位 + 自适应比例（六视图比例一致）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="448" width="300" height="78" as="geometry" />
        </mxCell>

        <!-- 出图模式 -->
        <mxCell id="mode" value="出图模式&#10;整体 / 局部外观" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="556" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="modeNote" value="局部外观模式（细则30条2款）&#10;实线 = 要求保护的局部&#10;虚线 = 其他部分&#10;无明确分界线 → 点划线表示分界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edf9;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="700" y="552" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e_mode_note" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="mode" target="modeNote">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 并行分叉 -->
        <mxCell id="fork" value="并行" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="445" y="670" width="90" height="50" as="geometry" />
        </mxCell>

        <!-- ③a -->
        <mxCell id="p3a" value="③a 六视图（正交投影）&#10;TechDraw 第一角投影，主/后/左/右/俯/仰&#10;&lt;font color=&quot;#b85450&quot;&gt;关闭隐藏线（虚线禁用）&lt;/font&gt;&#10;长对正 / 高平齐 / 宽相等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="750" width="270" height="95" as="geometry" />
        </mxCell>

        <!-- ③b -->
        <mxCell id="p3b" value="③b 立体图（等轴测线框）&#10;侧 45° 视角&#10;&lt;font color=&quot;#b85450&quot;&gt;线框图，不用着色渲染&lt;/font&gt;&#10;与六视图同比例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="750" width="270" height="95" as="geometry" />
        </mxCell>

        <!-- 汇合 -->
        <mxCell id="join" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="445" y="875" width="90" height="50" as="geometry" />
        </mxCell>

        <!-- ④ -->
        <mxCell id="p4" value="④ 专利规范化处理（官方规格固化）&#10;线型：粗细均匀实线，统一线宽（建议 0.25–0.5mm），无多余线条&#10;版面：150mm × 220mm @300DPI → 1772 × 2598 px，JPEG&#10;产品图形 ≥ 3cm × 8cm（细长物品除外）&#10;视图名称标注于视图正下方；图片内不含文字与图号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="290" y="955" width="420" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4fix" value="不合规 → 返回修正&#10;自动重出图（换比例/线宽）&#10;仍不合规则转人工复核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="960" width="200" height="76" as="geometry" />
        </mxCell>

        <!-- ⑤ -->
        <mxCell id="p5" value="⑤ 合规自检（硬性校验清单）&#10;格式：JPEG｜DPI 72–300｜像素 467.7×694.4 ～ 1948.8×2893.7&#10;图形尺寸区间｜缩小至 2/3 细节可辨｜总大小 ≤ 30MB&#10;禁线型检测（虚线/中心线/尺寸线/点划线/阴影线）&#10;六视图比例一致｜投影对齐｜视图命名齐全｜图内无文字" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="290" y="1105" width="420" height="115" as="geometry" />
        </mxCell>

        <!-- 决策 -->
        <mxCell id="d1" value="合规&#10;通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="1255" width="180" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e_d1_no" value="否" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;fontSize=11;" edge="1" parent="1" source="d1" target="p4fix">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="1302" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ⑥ -->
        <mxCell id="p6" value="⑥ 简要说明文书生成&#10;必填：产品名称｜用途｜设计要点&#10;指定一幅最能表明设计要点的视图（公报出版用）&#10;按情形补充：省略视图及原因｜变化状态｜透明部分｜色彩&#10;&lt;font color=&quot;#b85450&quot;&gt;禁用商业宣传用语；不得说明性能与内部结构&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="1395" width="420" height="120" as="geometry" />
        </mxCell>

        <!-- ⑦ -->
        <mxCell id="p7" value="⑦ 打包交付 output/&lt;产品名&gt;/&#10;六视图 JPEG ×6 + 立体图 + 六视图合版图&#10;简要说明.docx&#10;合规自检报告.json + 提交核对清单.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="1550" width="420" height="105" as="geometry" />
        </mxCell>

        <!-- 人工确认② -->
        <mxCell id="manual2" value="人工确认点 ②&#10;按提交核对清单复核" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="1690" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- 结束 -->
        <mxCell id="end" value="结束：可用于专利申请提交" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="1805" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- 主连线 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="start" target="input"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="input" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p1" target="manual1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="manual1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p2" target="mode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="mode" target="fork"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7a" value="并行" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;" edge="1" parent="1" source="fork" target="p3a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7b" value="并行" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;" edge="1" parent="1" source="fork" target="p3b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8a" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p3a" target="join"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8b" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p3b" target="join"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="join" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p5" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="是" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;" edge="1" parent="1" source="d1" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p7" target="manual2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="manual2" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 图例 -->
        <mxCell id="legend" value="图例：蓝=自动化处理（FreeCAD/Python）　橙=人工确认　绿=文书/交付　红=异常或不合规分支（含返回修正回路）　紫=局部外观模式　红字=硬性禁用项" style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="1880" width="880" height="25" as="geometry" />
        </mxCell>
        <mxCell id="skill" value="Skill 包结构：①01_parse_validate.py　②02_orient.py（FreeCAD 宏）　③03_generate_views.py　④04_normalize.py　⑤05_compliance_check.py　⑥06_brief_doc.py　⑦run_batch.py 总入口　＋ templates/简要说明模板.docx　＋ references/CNIPA制图合规规格.md&#10;依据：CNIPA《关于规范提交专利电子申请指引的通知》(2023-05-29)、专利审查指南(2024)、专利法实施细则第30条 · 2026-10-28" style="text;html=1;align=left;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1910" width="880" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
